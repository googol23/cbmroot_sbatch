#!/usr/bin/env bash
set -o pipefail

: "${CBM_RUN_DIR:?CBM_RUN_DIR is not defined. Submit through run_jobs.sh}"
SCRIPT_DIR="$CBM_RUN_DIR"
if source "${SCRIPT_DIR}/run_common.sh"; then
  :
else
  status=$?
  printf 'Failed to load pipeline setup (exit %s): %s\n' \
    "$status" "${SCRIPT_DIR}/run_common.sh" >&2
  exit "$status"
fi

QA_STEP_MACRO="$QA_TRANSPORT_MACRO"
QA_STEP_OUTPUT="$QA_TRANSPORT_OUTPUT"
QA_STEP_LOG="$QA_TRANSPORT_LOG"

require_file "$TRANSPORT_OUTPUT" "Transport output file"
require_file "$TRANSPORT_PARMET" "Transport parameter file"
require_file "$QA_STEP_MACRO" "Transport QA macro"
require_command root

qa_call="${QA_STEP_MACRO}(\"${TRANSPORT_OUTPUT}\",\"${TRANSPORT_PARMET}\",${NEVENTS},\"${QA_STEP_OUTPUT}\")"
log "Starting transport QA: ${QA_STEP_OUTPUT}"
run_logged_command "$QA_STEP_LOG" root -l -q -b "$qa_call"
require_file "$QA_STEP_OUTPUT" "Transport QA output"
log "Transport QA finished: ${QA_STEP_OUTPUT}"
