#!/usr/bin/env bash

set -o pipefail

: "${CBM_RUN_DIR:?CBM_RUN_DIR is not defined. Submit through run_jobs.sh}"
SCRIPT_DIR="$CBM_RUN_DIR"
if source "${SCRIPT_DIR}/run_common.sh"; then
  :
else
  setup_status=$?
  printf 'Failed to load pipeline setup (exit %s): %s\n' \
    "$setup_status" "${SCRIPT_DIR}/run_common.sh" >&2
  exit "$setup_status"
fi

# ---------------------------------------------------------------------------
# Validate requirements
# ---------------------------------------------------------------------------
require_file "${TRANSPORT_OUTPUT}" "Transport output file"
require_file "${TRANSPORT_PARMET}" "Transport parameter file"
require_file "${RAW_CONFIG_FILE}" "Configuration file"

require_command "${DIGITIZATION_BIN}"

# ---------------------------------------------------------------------------
# Digitization
# ---------------------------------------------------------------------------
run_command cp -- "$TRANSPORT_PARMET" "$DIGITIZATION_PARMET"

log "Starting digitization."
run_logged_command "${DIGITIZATION_LOG}" "${DIGITIZATION_BIN}" \
  -t "${TRANSPORT_OUTPUT}" \
  -p "${DIGITIZATION_PARMET}" \
  -o "${DIGITIZATION_OUTPUT}" \
  -c "${RAW_CONFIG_FILE}" \
  -n "${NEVENTS}" \
  -w

log "Digitization completed: ${DIGITIZATION_OUTPUT}"


