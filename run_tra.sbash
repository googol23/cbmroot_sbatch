#!/usr/bin/env bash

set -o pipefail

: "${CBM_RUN_DIR:?CBM_RUN_DIR is not defined. Submit through run_jobs.sh}"
SCRIPT_DIR="$CBM_RUN_DIR"
if source "${SCRIPT_DIR}/run_common.sh"; then
  :
else
  setup_status=$?
  printf 'Failed to load pipeline setup (exit %s): %s\n' \
    "$setup_status" "${SCRIPT_DIR}/run_common.sh" >&2
  exit "$setup_status"
fi

# ---------------------------------------------------------------------------
# Validate requirements
# ---------------------------------------------------------------------------

#require_file "${INPUT_FILE}" "Generator input file"
#require_file "${TRA_CONFIG_FILE}" "Configuration file"

#require_command "${TRANSPORT_BIN}"
#require_command "root"

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------

#log "Starting transport simulation."

run_logged_command "${TRANSPORT_LOG}" "${TRANSPORT_BIN}" \
 -i "unigen=${INPUT_FILE}" \
  -o "${TRANSPORT_OUTPUT}" \
  -c "${TRA_CONFIG_FILE}" \
  -s "${SETUP_TAG}" \
  -n "${NEVENTS}" \
  -w
  

