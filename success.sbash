#!/usr/bin/env bash
set -euo pipefail

: "${SLURM_JOB_ID:?Run through Slurm or run_jobs.sh --local}"

printf 'Pipeline test started: job=%s task=%s\n' \
    "$SLURM_JOB_ID" "${SLURM_ARRAY_TASK_ID:-batch}"

sleep 1

printf 'Pipeline test completed: job=%s task=%s\n' \
    "$SLURM_JOB_ID" "${SLURM_ARRAY_TASK_ID:-batch}"
