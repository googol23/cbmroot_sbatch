#!/usr/bin/env bash
set -euo pipefail

USER="${USER:-$(id -un)}"
export USER

: "${CFG_CBMROOT_SETUP:?Submit this job through run_jobs.sh}"
: "${CFG_OUTPUT_DIR:?Missing run output directory}"
: "${CFG_SETUP_TAG:?Missing setup tag}"
: "${TASK_RANGE:?Missing QA task range}"

# CbmRootConfig.sh is not nounset-safe.
set +u
source "$CFG_CBMROOT_SETUP" -o
set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
CBM_RUN_DIR="${CBM_RUN_DIR:-$SCRIPT_DIR}"
QA_MACRO="${CBM_RUN_DIR}/run_qa.C"

OUTPUT_DIR="$CFG_OUTPUT_DIR"
QA_OUT_DIR="${OUTPUT_DIR}/qa"
QA_OUTPUT="${QA_OUT_DIR}/qa.root"
QA_LOG="${QA_OUT_DIR}/qa.log"

[[ -s "$QA_MACRO" ]] || {
    echo "Missing QA macro: $QA_MACRO" >&2
    exit 1
}

mkdir -p "$QA_OUT_DIR"
rm -f "$QA_OUTPUT"

qa_call="${QA_MACRO}(\"${OUTPUT_DIR}\",\"${TASK_RANGE}\",\"${CFG_SETUP_TAG}\",-1)"

echo "Running QA"
echo "Task range: $TASK_RANGE"
echo "Input root: $OUTPUT_DIR"
echo "QA output:  $QA_OUTPUT"
echo "QA log:     $QA_LOG"

root -l -q -b "$qa_call" > "$QA_LOG" 2>&1

[[ -s "$QA_OUTPUT" ]] || {
    echo "QA did not produce output: $QA_OUTPUT (see $QA_LOG)" >&2
    exit 1
}

echo "QA finished: $QA_OUTPUT (log: $QA_LOG)"
